nt-weight:700}\n\n/* 页脚 */\nfooter{padding:30px 24px;background:#1f2330;color:#aab0c0;font-size:.85rem;text-align:center}\nfooter a{color:#c9b8ff;border-bottom-color:rgba(201,184,255,.4)}\n\n@media (max-width:600px){\n  section{padding:42px 18px}\n  .band{padding:42px 18px}\n}\n</style><main>\n\n\n<section class=\"hero\" id=\"top\" aria-label=\"大航海首屏\">\n  <div class=\"band band-violet\">\n    <span class=\"layer-mark\">层 01 / 海图</span>\n    <div class=\"inner\">\n      <span class=\"eyebrow\">流量型网络代理</span>\n      <h1>大航海<br>按月用度，自选航线。</h1>\n      <p>不绑定“全场景万金油”承诺，按你的月份流量与设备数量选套餐，节点分组在订阅链接里平铺呈现。</p>\n      <nav class=\"anchors\" aria-label=\"页面区块跳转\">\n        <a href=\"#plans\">查看套餐</a>\n        <a href=\"#how\">使用方法</a>\n        <a href=\"#clients\">订阅与客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </div>\n  <div class=\"band band-light\">\n    <span class=\"layer-mark\">层 02 / 舵盘</span>\n    <div class=\"inner\">\n      <p class=\"band-title\">三层菜单</p>\n      <p>套餐卡片、客户端配置、问题解答，从上到下逐层展开。无侧栏、无浮动按钮，所有跳转链接集中在首屏底部。</p>\n    </div>\n  </div>\n  <div class=\"band band-pale\">\n    <span class=\"layer-mark\">层 03 / 罗盘</span>\n    <div class=\"inner\">\n      <p class=\"band-title\">页面底部留白</p>\n      <p>没有侧边抽屉，没有横幅广告。每一层只展示一段内容，往下翻即可。</p>\n    </div>\n  </div>\n  <div class=\"band-bottom\">\n    <div class=\"inner\">\n      <span>大航海 · 自选航线页</span>\n      <span>继续往下滚动 →</span>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"plans\" aria-label=\"套餐与价格\">\n  <div class=\"inner\">\n    <h2>套餐</h2>\n    <p>按月计费，按年续费享同等总价；流量与设备上限是套餐主要差异。</p>\n\n    <article class=\"receipt\" aria-label=\"基础版套餐\">\n      <div class=\"receipt-head\">\n        <h3>基础版</h3>\n        <span class=\"tag\">入门</span>\n      </div>\n      <p class=\"price-line\"><strong>¥15</strong> /月 · <span class=\"annual\">按年付仅需 ¥150/年</span></p>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"receipt\" aria-label=\"旗舰版套餐\">\n      <div class=\"receipt-head\">\n        <h3>旗舰版</h3>\n        <span class=\"tag tag-flag\">推荐</span>\n      </div>\n      <p class=\"price-line\"><strong>¥35</strong> /月 · <span class=\"annual\">按年付仅需 ¥350/年</span></p>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"receipt\" aria-label=\"团队版套餐\">\n      <div class=\"receipt-head\">\n        <h3>团队版</h3>\n        <span class=\"tag\">企业</span>\n      </div>\n      <p class=\"price-line\"><strong>¥85</strong> /月 · <span class=\"annual\">按年付仅需 ¥850/年</span></p>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n\n    <p>价格与权益以结算页实际显示为准；所有套餐均在每月周期开始前完成扣款。</p>\n  </div>\n</section>\n\n\n<section id=\"how\" aria-label=\"使用说明\">\n  <div class=\"inner\">\n    <h2>使用方法</h2>\n    <ol class=\"steps\">\n      <li>注册账号并完成邮箱验证，记录用户中心返回的订阅链接。</li>\n      <li>在下单页挑选套餐，确认月付或年付方式后完成支付。</li>\n      <li>回到用户中心复制订阅地址，粘贴至支持订阅导入的客户端。</li>\n      <li>在客户端中刷新节点列表，选择分组内的可用线路进行连接。</li>\n      <li>本月流量用尽或周期到期后，可续费继续或停止订阅。</li>\n    </ol>\n  </div>\n</section>\n\n\n<section id=\"clients\" aria-label=\"客户端与订阅\">\n  <div class=\"inner\">\n    <h2>订阅与客户端</h2>\n    <p>订阅地址在用户中心“订阅管理”内获取；下列客户端为常见参考项，请在官方下载页核对最新版本。</p>\n    <article class=\"receipt\" aria-label=\"客户端参考列表\">\n      <div class=\"receipt-head\"><h3>客户端参考</h3><span class=\"tag\">列表</span></div>\n      <div class=\"client-row\"><b>Windows / macOS</b><span>桌面端通用订阅客户端</span></div>\n      <div class=\"client-row\"><b>Android</b><span>移动端订阅客户端</span></div>\n      <div class=\"client-row\"><b>iOS</b><span>需通过外区账号或通用导入工具使用</span></div>\n      <div class=\"client-row\"><b>路由器 / 软路由</b><span>订阅链接可填入相关路由插件</span></div>\n      <div class=\"client-row\"><b>命令行</b><span>服务端与命令行工具均可读取订阅</span></div>\n    </article>\n    <p>具体下载地址与版本号请以官方页面为准；本页仅做使用方向说明。</p>\n  </div>\n</section>\n\n\n<section id=\"faq\" aria-label=\"常见问题\">\n  <div class=\"inner\">\n    <h2>常见问题</h2>\n    <div class=\"faq-stack\">\n      <details>\n        <summary>套餐中提到的设备数是怎么计算的？</summary>\n        <p>按同一账号同时在线的客户端实例数计算。关闭客户端连接或断开节点后，该计数会随之下调。</p>\n      </details>\n      <details>\n        <summary>每月流量用完后会怎样？</summary>\n        <p>本周期内剩余流量不再累加到下一周期。账号仍可正常登录，不会主动断网；下一周期开始后配额自动重置。</p>\n      </details>\n      <details>\n        <summary>是否支持更换套餐？</summary>\n        <p>支持。变更后的套餐自下一个计费周期起生效，已支付的本周期费用不退还；可在用户中心提交变更申请。</p>\n      </details>\n      <details>\n        <summary>订阅链接怎么导入到客户端？</summary>\n        <p>复制用户中心内的订阅地址，在客户端的“订阅设置”或“服务器订阅”处粘贴并保存，随后手动刷新一次节点列表。</p>\n      </details>\n      <details>\n        <summary>节点分组在哪里查看？</summary>\n        <p>订阅链接默认带分组信息，刷新后客户端会按地区或线路类型分组展示；具体可见名称以订阅源内定义为准。</p>\n      </details>\n      <details>\n        <summary>支付和发票相关问题</summary>\n        <p>结算页支持的支付方式以页面提示为准。如需开具发票，请在用户中心提交抬头与税号信息，审核后开具。</p>\n      </details>\n      <details>\n        <summary>如何联系客服与提交工单？</summary>\n        <p>用户中心提供工单入口。请尽量附上订单号、客户端版本与必要截图，以便核对订阅与节点状态。</p>\n      </details>\n    </div>\n\n    <h2>联系与说明</h2>\n    <article class=\"receipt\">\n      <div class=\"receipt-head\"><h3>条款摘要</h3><span class=\"tag\">说明</span></div>\n      <ul>\n        <li>禁止用于违反所在地区法律法规的活动。</li>\n        <li>套餐价格、流量额度与设备上限均以本页“套餐”部分列示为准。</li>\n        <li>页面内容如与结算页实际信息不一致，以结算页显示为准。</li>\n      </ul>\n    </article>\n  </div>\n</section>\n\n</main>\n<footer>\n  <p>大航海 · 按月流量与节点订阅 · 页面信息仅供参考</p>\n  <p><a href=\"#top\">回到顶部</a></p>\n</footer>",
